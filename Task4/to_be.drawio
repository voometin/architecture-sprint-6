        <mxCell id="cZmoxPCs9f-jtr3tjs0I-5" value="&lt;div&gt;&lt;b&gt;Запись&amp;nbsp;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212)); color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ответа по&amp;nbsp;&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212)); color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;заявкам ОСАГО&lt;br&gt;от страховых&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;[Pub]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="cZmoxPCs9f-jtr3tjs0I-4">
