        <mxCell id="wl8n7hgJDAQSW8y2Bq48-9" value="&lt;div&gt;&lt;b&gt;Получение информации&amp;nbsp;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;по продуктам и тарифам&lt;/b&gt;&lt;/div&gt;&lt;div&gt;[Sub]&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="wl8n7hgJDAQSW8y2Bq48-7">
